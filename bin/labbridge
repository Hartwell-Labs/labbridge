#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/labbridge"

# labbridge — Hartwell Labs Rust<->Ruby plugin bridge.
#
#   labbridge r2ruby plugin.rs [-o out.rb]   Rust -> Ruby
#   labbridge r2rust plugin.rb [-o out.rs]   Ruby -> Rust (plugin host contract)
#   labbridge manifest plugin.rb             print plugin manifest as JSON
#   labbridge roundtrip plugin.rb            ruby -> rust -> ruby sanity check
command = ARGV.shift
$output = nil
$target = nil

OptionParser.new do |o|
  o.banner = "usage: labbridge <r2ruby|r2rust|manifest|roundtrip> [file] [options]"
  o.on("-o", "--output PATH", "write result to PATH instead of stdout") { |v| $output = v }
  o.on("-t", "--target TARGET", "verify target is a Hartwell Labs product (talus/aurora/externum)") { |v| $target = v }
  o.on("-h", "--help", "show this help") { abort o.to_s }
end.parse!

def read_input(path)
  path.nil? || path == "-" ? $stdin.read : File.read(path)
end

def write_output(path, content)
  $output ? File.write(path, content) : print(content)
end

begin
  case command
  when "r2ruby"
    src = read_input(ARGV[0])
    write_output($output, LabBridge::Rust2Ruby.new.translate(src, target: $target))
  when "r2rust"
    src = read_input(ARGV[0])
    write_output($output, LabBridge::Ruby2Rust.new.translate(src))
  when "targets"
    puts JSON.pretty_generate(LabBridge::Registry.products.transform_values { |p| p.is_a?(Hash) ? p.slice(:name, :repo, :packages) : p })
  when "manifest"
    src = read_input(ARGV[0])
    puts LabBridge::Manifest.from_ruby(src).to_json
  when "roundtrip"
    src = read_input(ARGV[0])
    rust = LabBridge::Ruby2Rust.new.translate(src)
    back = LabBridge::Rust2Ruby.new.translate(rust)
    ok = back.include?("def handle_event")
    puts ok ? "roundtrip OK (#{rust.lines.count} rust lines -> #{back.lines.count} ruby lines)" : "roundtrip FAILED"
    abort unless ok
  when nil, "help"
    abort "usage: labbridge <r2ruby|r2rust|manifest|roundtrip|targets> [file] [-o PATH] [-t TARGET]"
  else
    abort "unknown command: #{command}"
  end
rescue LabBridge::Error => e
  warn "labbridge: #{e.message}"
  exit 2
end
